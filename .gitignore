# Secrets and keys — never committed
.env
*.pem
*.key
!testdata/**/*.pem
# Local key directory at the repo root only; internal/keys is source code.
/keys/

# Receipt logs and stores produced locally
*.db
*.db-wal
*.db-shm
*.jsonl
!testdata/**/*.jsonl

# Demo output (generated keys, logs, and tampered copies)
/demo-output/

# Default `warden init` directory: private keys, receipt store, and secrets
/warden-local/

# Agent corpus runs (transcripts, receipt logs, public keys)
/agent-runs/

# Go
/bin/
/dist/
*.test
# Binaries from `go build ./cmd/NAME` at the repository root
/warden
/warden-verify
/warden-demo
/warden-gate
/example-tools
*.out
coverage.*

# Python (demo and benchmark)
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editors
.DS_Store
.idea/
.vscode/
